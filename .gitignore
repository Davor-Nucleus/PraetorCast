# Environment & configuration sensible
.env
.env.local
.env.*.local
env.json
# env-model.json est le MODELE a copier en env.json : il ne contient aucun secret et
# doit etre livre avec le depot. Il etait ignore par regle tout en restant suivi --
# la regle n'a jamais eu d'effet, mais elle aurait fait manquer toute mise a jour.
*.secret
*.key
*.pem
config.local.*

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Backup files
*.bak
*.backup
*.tmp
*.temp

# Musique et sons
public/music/*
!public/music/example/
!public/music/example/**

public/soundboard/*
!public/soundboard/song.txt

# Etat runtime reecrit par l'app (un "Save" le modifie)
/data/banner.json
/data/scheduler.json
/data/channel_points.json
/data/goal.json

/public/channelpoint/*

public/banner/*
!public/banner/banner.txt

public/scheduler/*
!public/scheduler/scheduler.txt

public/font/*
!public/font/font.txt

# Binaires compiles : produits par `node ./compile/build.cjs` depuis les depots freres.
# Ils etaient suivis, ce qui ajoutait ~26 Mo non compressibles a l'historique a chaque
# cycle de rebuild (.git avait atteint 154 Mo pour 26 fichiers). Ils se redistribuent
# par release, pas par commit.
*.exe

# NE PAS ignorer compile/ : `node ./compile/build.cjs` est la procedure de compilation
# documentee dans le README. La regle `compile/` rendait tout clone incompilable.


# Fichiers de build
dist/
build/
out/

